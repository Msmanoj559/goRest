				{
					"listen": "test",
					"script": {
						"id": "b41361a8-3949-47be-8882-ef84cfd3d8aa",
						"exec": [
							"pm.test(\"UID Saved in variable\", function()\r",
							"{\r",
							"\r",
							"var jsonData = JSON.parse(responseBody);\r",
							"var id=jsonData.id;\r",
							"pm.environment.set(\"uid\",id);\r",
							"\r",
							"});\r",
							"\r",
							"\r",
							"\r",
							"\r",
							"pm.test(\"Successfull\", function()\r",
							"{\r",
							"pm.response.to.have.status(201);\r",
							"});\r",
							"\r",
							"\r",
							"pm.test(\"Status code name has string\", function () {\r",
							"    pm.response.to.have.status(\"Created\");\r",
							"});\r",
							"\r",
							"\r",
							"\r",
							"var jsonData = JSON.parse(responseBody);\r",
							"pm.test(\"Gender is Correct\", function()\r",
							"{\r",
							"const expectGender=\"male\";\r",
							"var gender=jsonData.gender;\r",
							"pm.expect(gender).to.equals(expectGender);\r",
							"});\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
