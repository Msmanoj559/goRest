	"item": [
		{
			"name": "Create",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"UID is saved in environment variable\", function () {\r",
							"    const jsonData = pm.response.json();\r",
							"    pm.expect(jsonData).to.have.property(\"id\");\r",
							"\r",
							"    pm.environment.set(\"uid\", jsonData.id);\r",
							"});\r",
							"\r",
							"pm.test(\"Successfull created success code matched 201\", function()\r",
							"{\r",
							"pm.response.to.have.status(201);\r",
							"});\r",
							"\r",
							"\r",
							"pm.test(\"Status code name has string\", function () {\r",
							"    pm.response.to.have.status(\"Created\");\r",
							"});\r",
							"\r",
							"var jsonData = JSON.parse(responseBody);\r",
							"pm.test(\"Gender is Correct\", function()\r",
							"{\r",
							"const expectGender=\"male\";\r",
							"var gender=jsonData.gender;\r",
							"pm.expect(gender).to.equals(expectGender);\r",
							"});\r",
							"\r",
							"pm.test(\"Response time is less than 200ms\", function () {\r",
							"    pm.expect(pm.response.responseTime).to.be.below(200);\r",
							"});\r",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"var random = Math.random().toString(32).substring(2);\r",
							"var name= \"Abc\" + random;\r",
							"var email= \"Abc\" +random + \"@gmail.com\";\r",
							"pm.environment.set(\"uname\", name);\r",
							"pm.environment.set(\"uemail\", email);"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{token}}",
							"type": "string"
						}
					]
				},
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n    \"name\":\"{{uname}}\",\r\n     \"gender\":\"male\", \r\n     \"email\":\"{{uemail}}\",\r\n      \"status\":\"active\"\r\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{BASE_URL}}/public/v2/users",
					"host": [
						"{{BASE_URL}}"
					],
					"path": [
						"public",
						"v2",
						"users"
					]
				}
			},
			"response": []
		},
